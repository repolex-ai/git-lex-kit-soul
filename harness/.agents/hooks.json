{
  "soul-recall": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/UserPromptSubmit-soul-recall.py",
        "timeout": 5
      }
    ]
  },
  "soul-save": {
    "Stop": [
      {
        "type": "command",
        "command": "git lex save 'Session end auto-save' && git lex sync",
        "timeout": 15
      }
    ]
  }
}
